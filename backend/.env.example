QWEN_BASE_URL=http://127.0.0.1:6001/v1
QWEN_API_KEY=replace-with-your-api-key
QWEN_MODEL=replace-with-your-multimodal-model
# Template review domain concurrency (1-7). Lower it only when the model gateway rejects burst load.
QWEN_DOMAIN_CONCURRENCY=7
# Complete Schema request retries after the initial attempt (0-2).
QWEN_SCHEMA_RETRIES=1
PORT=8787
FRONTEND_ORIGIN=http://127.0.0.1:4173
BILU_DEBUG_LOGS=true
# Only enable for approved synthetic or desensitized data. Full prompts and model payloads are written to disk.
BILU_LOG_PAYLOADS=false
