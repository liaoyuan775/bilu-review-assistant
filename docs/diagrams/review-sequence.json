{
  "title": "笔录审查完整时序",
  "participants": [
    {"id": "user", "label": "用户", "actor": true},
    {"id": "web", "label": "前端 4173"},
    {"id": "api", "label": "FastAPI 8787"},
    {"id": "parser", "label": "文档解析器"},
    {"id": "victim", "label": "被害人信息提取"},
    {"id": "orch", "label": "6 域编排器"},
    {"id": "builder", "label": "域提示词 / Schema 生成器"},
    {"id": "qwen", "label": "Qwen3.6-35B-A3B"},
    {"id": "validator", "label": "归一化 / 校验器"},
    {"id": "rules", "label": "34 条规则引擎"},
    {"id": "store", "label": "任务存储"}
  ],
  "messages": [
    {"from": "user", "to": "web", "label": "选择并上传 DOCX / PDF"},
    {"from": "web", "to": "api", "label": "POST /api/v1/reviews"},
    {"from": "api", "to": "store", "label": "创建 processing 任务"},
    {"from": "api", "to": "parser", "label": "解析文件"},
    {"from": "parser", "to": "parser", "label": "OpenXML/PDF：段落、表格、页眉页脚"},
    {"from": "parser", "to": "parser", "label": "图片 VLM 转写并按正文位置插入"},
    {"from": "parser", "to": "parser", "label": "重建完整 QA 与非 QA 证据块"},
    {"from": "parser", "to": "api", "label": "ParsedDocument + EvidenceBlock", "return": true},
    {"from": "api", "to": "victim", "label": "提取 victimProfile"},
    {"from": "victim", "to": "api", "label": "被害人卡片字段", "return": true},
    {"from": "api", "to": "orch", "label": "run_template_review(document)"},
    {"note": "Semaphore=6；正常健康路径共 6 个域请求", "over": "orch"},
    {"from": "orch", "to": "builder", "label": "域 1..6：加载公共模板 + 对应域提示"},
    {"from": "builder", "to": "builder", "label": "从 domain-contract JSON 生成字段说明"},
    {"from": "builder", "to": "builder", "label": "生成 additionalProperties=false 的 JSON Schema"},
    {"from": "builder", "to": "qwen", "label": "并发请求：strict=true, thinking=false"},
    {"note": "禁止 plain JSON / tool fallback", "over": "qwen"},
    {"from": "qwen", "to": "validator", "label": "域 JSON 结果"},
    {"from": "validator", "to": "validator", "label": "json.loads + Pydantic + 锚点/实体/路径校验"},
    {"from": "validator", "to": "builder", "label": "Schema 失败：附失败详情，最多重试配置次数", "return": true},
    {"from": "builder", "to": "qwen", "label": "仅失败域再次 strict Schema 请求"},
    {"from": "qwen", "to": "validator", "label": "修正后的域 JSON"},
    {"from": "validator", "to": "orch", "label": "6 域合法事实与实体", "return": true},
    {"note": "网络/超时/5xx 走独立 transient retry；耗尽则记录失败域", "over": "orch"},
    {"from": "orch", "to": "rules", "label": "约 80 个事实 + 实体 + 完整 QA 状态"},
    {"from": "rules", "to": "rules", "label": "appliesWhen：不适用 / 待人工判断"},
    {"from": "rules", "to": "rules", "label": "required：缺失与不清；明确否定视为有效"},
    {"from": "rules", "to": "rules", "label": "advisory：缺失只提示，不阻断"},
    {"from": "rules", "to": "rules", "label": "repeatEntity：逐笔字段与数量"},
    {"from": "rules", "to": "rules", "label": "consistency：金额、时间、数量冲突"},
    {"from": "rules", "to": "orch", "label": "34 条结果 + 六类状态 + 证据锚点", "return": true},
    {"from": "orch", "to": "api", "label": "TemplateReviewOutcome", "return": true},
    {"from": "api", "to": "store", "label": "保存抽取载荷、结果、耗时和失败域"},
    {"from": "api", "to": "web", "label": "202 + taskId", "return": true},
    {"from": "web", "to": "api", "label": "轮询 GET /reviews/{taskId}"},
    {"from": "api", "to": "store", "label": "读取任务"},
    {"from": "store", "to": "api", "label": "任务 + 34 条结果", "return": true},
    {"from": "api", "to": "web", "label": "六类汇总、被害人卡片、完整 QA 证据", "return": true},
    {"from": "web", "to": "user", "label": "展示审查结果并支持人工处理/归档", "return": true}
  ]
}
